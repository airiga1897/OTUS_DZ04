user www-data;
worker_processes auto;
pid /run/nginx.pid;
events { worker_connections 4096; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
    sendfile on;
    keepalive_timeout 30;
    client_max_body_size 5m;
    uwsgi_cache_path /var/cache/nginx/otus levels=1:2 keys_zone=static_cache:16m max_size=256m inactive=30m;
    upstream application {
        zone application 64k;
{% for node in groups['backend'] %}
        server {{ hostvars[node].private_ip }}:3031 max_fails=1 fail_timeout=5s;
{% endfor %}
    }
    server {
        listen 8080;
        location = /health/front { access_log off; return 200 "nginx {{ inventory_hostname }}\\n"; }
        location / { return 404; }
    }
    server {
        listen 80 default_server;
        server_name _;
        add_header X-Frontend-Node {{ inventory_hostname }} always;
        location / {
            include /etc/nginx/uwsgi_params;
            uwsgi_pass application;
            uwsgi_connect_timeout 2s;
            uwsgi_read_timeout 15s;
            uwsgi_next_upstream error timeout http_500 http_503;
            uwsgi_next_upstream_tries 2;
            uwsgi_next_upstream_timeout 20s;
        }
        location ~ ^/(static|media)/ {
            include /etc/nginx/uwsgi_params;
            uwsgi_pass application;
            uwsgi_connect_timeout 2s;
            uwsgi_read_timeout 15s;
            uwsgi_next_upstream error timeout http_500 http_503;
            uwsgi_next_upstream_tries 2;
            uwsgi_cache static_cache;
            uwsgi_cache_key "$scheme$request_method$host$request_uri";
            uwsgi_cache_valid 200 1m;
            add_header X-Static-Cache $upstream_cache_status always;
            add_header X-Frontend-Node {{ inventory_hostname }} always;
            add_header X-Content-Type-Options nosniff always;
        }
    }
}

